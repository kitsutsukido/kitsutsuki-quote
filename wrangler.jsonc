{
  // 謎文具キツツキ堂 見積台帳(Cloudflare Workers)。
  // 静的ファイルはビルド結果(dist)をそのまま配信し、/api/* だけ worker/index.js が処理する。
  // 秘密の値(SESSION_SIGNING_SECRET / ALLOWED_EMAILS / GOOGLE_CLIENT_ID)はここに書かず、
  // Cloudflareダッシュボードの「設定 → 変数とシークレット」に「シークレット」として登録する。
  "name": "kitsutsuki-quote",
  "main": "worker/index.js",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // 在庫管理アプリと同じKV namespaceを共有(キーは必ず "zk-quote:" で始まるものだけ使う)
  "kv_namespaces": [{ "binding": "QUOTE_KV", "id": "37f283c110dc4de3bd099999fc3f066a" }],
  // 毎朝9時(日本時間)=0時(UTC)に、入稿期限の当日リマインダーを送る
  "triggers": { "crons": ["0 0 * * *"] },
  "observability": { "enabled": true }
}
